{
  "name": "winlaunch",
  "productName": "WinLaunch",
  "version": "1.0.0",
  "description": "WinLaunch - Custom OS-style launcher (safe, does not touch WinLogon or Explorer)",
  "main": "main.js",
  "author": "memolyrx",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . WinLaunch --platform=win32 --arch=x64 --out=dist --overwrite --asar"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "@electron/packager": "18.3.6"
  }
}
